# Python
__pycache__/
*.pyc
.venv/
venv/

# Node / web build
web/node_modules/
# web/dist is COMMITTED for Vercel: the FastAPI serverless function serves it as
# static files (single-function deploy). Rebuild + commit after frontend changes:
#   cd web && npm run build

# data/draft.db is COMMITTED (not ignored) so the Vercel function ships with its
# data and needs no build step. Rebuild locally any time with: draft.bat build

# Collected match outcomes (re-collectable via lol_draft.collect; can be large,
# and labels are tied to a key/region — keep out of git)
data/games/

# Trained model artifacts: commit the DEPLOYED model + its bootstrap ensemble
# (Vercel needs both — the ensemble drives the win-prob error bars / tie flags;
# without it the serve path silently falls back to point estimates), ignore
# experimental variants (e.g. winprob_allpatches.json).
data/models/*
!data/models/winprob.json
!data/models/winprob_bootstrap.json

# PyInstaller desktop build (large binary; distribute via a Release, not git)
/build/
/dist/
*.spec

# OS junk
Thumbs.db
.DS_Store

# Keep: data/raw/* (source data) and web/src/mock/champions.ts (generated, committed)
.vercel
